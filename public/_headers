# Cache: hashed build assets and fonts are immutable; pagefind chunks are
# content-hashed too but the entry files revalidate daily.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
/pagefind/*
  Cache-Control: public, max-age=86400

# Security baseline for every page.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# RFC 9727 API catalog: no file extension to infer a type from (same rule as
# live-contracts).
/.well-known/api-catalog
  Content-Type: application/linkset+json
  Cache-Control: public, max-age=86400
