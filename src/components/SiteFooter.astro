---
// Ink-band footer: browse/trust/project columns, the wordmark, the license line.
---

<footer class="no-print mt-16 bg-[#2b2e35] text-white">
  <div class="mx-auto w-full max-w-[1280px] px-5 pt-11 pb-7 sm:px-10">
    <div class="flex flex-wrap items-start gap-x-14 gap-y-8">
      <div
        class="ald-meta grid grid-cols-2 gap-x-14 gap-y-2 text-[0.65625rem] leading-8 sm:grid-cols-3"
      >
        <div>
          <div class="mb-1.5 text-white/45">Browse</div>
          <a href="/" class="hover:text-accent-lift block no-underline"
            >All areas</a
          >
          <a href="/search/" class="hover:text-accent-lift block no-underline"
            >Search</a
          >
          <a href="/sitemap/" class="hover:text-accent-lift block no-underline"
            >Sitemap</a
          >
        </div>
        <div>
          <div class="mb-1.5 text-white/45">Trust</div>
          <a
            href="/methodology/"
            class="hover:text-accent-lift block no-underline">Methodology</a
          >
          <a
            href="/methodology/#the-floor"
            class="hover:text-accent-lift block no-underline">↳ The purge</a
          >
          <a
            href="/skos.jsonld"
            class="hover:text-accent-lift block no-underline">SKOS scheme</a
          >
        </div>
        <div>
          <div class="mb-1.5 text-white/45">Project</div>
          <a
            href="https://w3id.org/digest-law/us/"
            class="hover:text-accent-lift block no-underline">w3id.org ↗</a
          >
          <a
            href="https://w3id.org/legal-taxonomy/"
            class="hover:text-accent-lift block no-underline"
            >Legal taxonomy ↗</a
          >
        </div>
      </div>
      <span class="flex-1"></span>
      <div
        class="font-display flex-none text-[clamp(3rem,8vw,6rem)] leading-[0.9] tracking-[-0.03em] text-white/95"
      >
        digest.law
      </div>
    </div>
    <div class="ald-dashed my-6 text-white/40"></div>
    <div
      class="ald-meta flex flex-wrap gap-x-6 gap-y-2 text-[0.59375rem] text-white/45"
    >
      <span
        >American Legal Digest — machine-researched, review-gated, evidence
        attached · not legal advice</span
      >
      <span class="flex-1"></span>
      <span
        >Digest text: <a
          href="https://creativecommons.org/licenses/by/4.0/"
          rel="license"
          class="hover:text-accent-lift underline decoration-white/30 underline-offset-2"
          >Creative Commons Attribution 4.0 International Public License</a
        > · sources public domain or as-licensed</span
      >
    </div>
  </div>
</footer>
