---
// Michigan-blue band footer: browse/trust/project columns, the wordmark, the
// license line. The blue is hardcoded, not tokenised — this band stays the same
// in both themes, whereas --ald-accent lifts to a pale blue under dark.
---

<footer class="no-print mt-16 bg-[#00274c] text-white">
  <div class="mx-auto w-full max-w-[1280px] px-5 pt-11 pb-7 sm:px-10">
    <div class="flex flex-wrap items-start gap-x-14 gap-y-8">
      <div
        class="ald-meta grid grid-cols-2 gap-x-14 gap-y-2 text-[0.6875rem] leading-8 sm:grid-cols-3"
      >
        <div>
          <div class="mb-1.5 text-white/65">Browse</div>
          <a class="hover:text-accent-lift block no-underline" href="/"
            >All areas</a
          >
          <a class="hover:text-accent-lift block no-underline" href="/search/"
            >Search</a
          >
          <a class="hover:text-accent-lift block no-underline" href="/sitemap/"
            >Sitemap</a
          >
        </div>
        <div>
          <div class="mb-1.5 text-white/65">Trust</div>
          <a class="hover:text-accent-lift block no-underline" href="/about/"
            >About</a
          >
          <a
            class="hover:text-accent-lift block no-underline"
            href="/methodology/"
            >Methodology</a
          >
          <a
            class="hover:text-accent-lift block no-underline"
            href="/methodology/#the-floor"
            >↳ The purge</a
          >
          <a class="hover:text-accent-lift block no-underline" href="/committee/"
            >Review committee</a
          >
          <a
            class="hover:text-accent-lift block no-underline"
            href="/skos.jsonld"
            >SKOS scheme</a
          >
        </div>
        <div>
          <div class="mb-1.5 text-white/65">Project</div>
          <a class="hover:text-accent-lift block no-underline" href="/contact/"
            >Contact</a
          >
          <a
            class="hover:text-accent-lift block no-underline"
            href="/contact/?topic=reviewer"
            >↳ Become a reviewer</a
          >
          <a
            class="hover:text-accent-lift block no-underline"
            href="https://w3id.org/digest-law/us/"
            >w3id.org ↗</a
          >
          <a
            class="hover:text-accent-lift block no-underline"
            href="https://w3id.org/legal-taxonomy/"
            >Legal taxonomy ↗</a
          >
        </div>
      </div>
      <span class="flex-1"></span>
      <div
        class="font-display flex-none text-[clamp(3rem,8vw,6rem)] leading-[0.9] tracking-[-0.03em] text-white/95"
      >
        digest.law
      </div>
    </div>
    <div class="ald-dashed my-6 text-white/45"></div>
    <div
      class="ald-meta flex flex-wrap gap-x-6 gap-y-2 text-[0.65625rem] leading-[1.7] text-white/75"
    >
      <span
        >American Legal Digest — machine-researched, review-gated, evidence
        attached · not legal advice</span
      >
      <span class="flex-1"></span>
      <span
        >Digest text:
        <a
          class="hover:text-accent-lift underline decoration-white/55 underline-offset-2"
          href="https://creativecommons.org/licenses/by/4.0/"
          rel="license"
          >Creative Commons Attribution 4.0 International Public License</a
        >
        · sources public domain or as-licensed</span
      >
    </div>
  </div>
</footer>
