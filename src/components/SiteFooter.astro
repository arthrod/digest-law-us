---
// Michigan-blue band footer: browse/trust/project columns, the wordmark, the
// license line. The blue is hardcoded, not tokenised — this band stays the same
// in both themes, whereas --ald-accent lifts to a pale blue under dark.
---

<footer class="no-print mt-16 bg-[#00274c] text-white">
  <div class="mx-auto w-full max-w-[1280px] px-5 pt-11 pb-7 sm:px-10">
    <div class="flex flex-wrap items-start gap-x-14 gap-y-8">
      <div
        class="ald-meta grid grid-cols-2 gap-x-14 gap-y-2 text-[0.6875rem] leading-8 sm:grid-cols-3"
      >
        <div>
          <div class="mb-1.5 text-white/65">Browse</div>
          <a class="hover:text-accent-lift block no-underline" href="/"
            >All areas</a
          >
          <a class="hover:text-accent-lift block no-underline" href="/search/"
            >Search</a
          >
          <a class="hover:text-accent-lift block no-underline" href="/sitemap/"
            >Sitemap</a
          >
        </div>
        <div>
          <div class="mb-1.5 text-white/65">Trust</div>
          <a class="hover:text-accent-lift block no-underline" href="/about/"
            >About</a
          >
          <a
            class="hover:text-accent-lift block no-underline"
            href="/methodology/"
            >Methodology</a
          >
          <a
            class="hover:text-accent-lift block no-underline"
            href="/methodology/#the-floor"
            >↳ The purge</a
          >
          <a class="hover:text-accent-lift block no-underline" href="/committee/"
            >Review committee</a
          >
          <a
            class="hover:text-accent-lift block no-underline"
            href="/skos.jsonld"
            >SKOS scheme</a
          >
        </div>
        <div>
          <div class="mb-1.5 text-white/65">Project</div>
          <a class="hover:text-accent-lift block no-underline" href="/contact/"
            >Contact</a
          >
          <a
            class="hover:text-accent-lift block no-underline"
            href="/contact/?topic=reviewer"
            >↳ Become a reviewer</a
          >
          <a
            class="hover:text-accent-lift block no-underline"
            href="https://w3id.org/digest-law/us/"
            >w3id.org ↗</a
          >
          <a
            class="hover:text-accent-lift block no-underline"
            href="https://w3id.org/legal-taxonomy/"
            >Legal taxonomy ↗</a
          >
        </div>
      </div>
      <span class="flex-1"></span>
      <div
        class="font-display flex-none text-[clamp(3rem,8vw,6rem)] leading-[0.9] tracking-[-0.03em] text-white/95"
      >
        digest.law
      </div>
    </div>
    <div class="ald-dashed my-6 text-white/45"></div>
    <!--
      Theme toggle. Phosphor "moon"/"sun" (regular), inlined rather than
      imported — the site ships no icon runtime, and these are the only two.
      The moon shows on light (what you get if you press it) and vice versa.
      theme.ts drives this by id; it is the only #theme-btn on the page.
    -->
    <button
      class="ald-meta mb-5 inline-flex items-center gap-2 text-white/75 hover:text-white"
      id="theme-btn"
      type="button"
    >
      <svg
        class="dark:hidden"
        fill="none"
        height="17"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="16"
        viewBox="0 0 256 256"
        width="17"
        aria-hidden="true"
      >
        <path
          d="M108.11,28.11A96.09,96.09,0,0,0,227.89,147.89,96,96,0,1,1,108.11,28.11Z"
        ></path>
      </svg>
      <svg
        class="hidden dark:inline"
        fill="none"
        height="17"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="16"
        viewBox="0 0 256 256"
        width="17"
        aria-hidden="true"
      >
        <circle cx="128" cy="128" r="56"></circle>
        <line x1="128" x2="128" y1="40" y2="16"></line>
        <line x1="64" x2="48" y1="64" y2="48"></line>
        <line x1="64" x2="48" y1="192" y2="208"></line>
        <line x1="192" x2="208" y1="64" y2="48"></line>
        <line x1="192" x2="208" y1="192" y2="208"></line>
        <line x1="40" x2="16" y1="128" y2="128"></line>
        <line x1="128" x2="128" y1="216" y2="240"></line>
        <line x1="216" x2="240" y1="128" y2="128"></line>
      </svg>
      <span class="dark:hidden">Dark</span><span class="hidden dark:inline"
        >Light</span
      >
    </button>
    <div
      class="ald-meta flex flex-wrap gap-x-6 gap-y-2 text-[0.65625rem] leading-[1.7] text-white/75"
    >
      <!-- The {" "} are load-bearing: a newline between text and an inline
           element is stripped, which glued "text:" to the link title. -->
      <span
        >Digest text:{" "}<a
          class="hover:text-accent-lift underline decoration-white/55 underline-offset-2"
          href="https://creativecommons.org/licenses/by/4.0/"
          rel="license"
          >Creative Commons Attribution 4.0 International Public License</a
        >{" "}· sources public domain or as-licensed</span
      >
    </div>
  </div>
</footer>
