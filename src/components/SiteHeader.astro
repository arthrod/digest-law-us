---
interface Props {
  /** "dark" renders the ink-band header used by the home hero */
  tone?: "light" | "dark";
}
const { tone = "light" } = Astro.props;
const dark = tone === "dark";

/**
 * Nav lives behind a MENU disclosure rather than inline: the bar had grown to
 * five links and was wrapping to a second row on narrow viewports. Built on
 * <details>, so it opens without JavaScript — the script below only adds the
 * dismissal affordances (outside click, Escape) that <details> lacks.
 */
const links = [
  { href: "/", label: "All areas" },
  { href: "/methodology/", label: "Methodology" },
  { href: "/committee/", label: "Committee" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
];

const chip = [
  "ald-meta inline-flex h-[30px] items-center gap-2 rounded-[2px] border px-2.5 no-underline",
  dark
    ? "border-white/30 text-white/80 hover:bg-white/10"
    : "border-hairline text-ink-muted hover:border-ink",
];
---

<header
  class:list={[
    "no-print",
    dark ? "bg-[#000000] text-white" : "bg-surface text-ink",
  ]}
>
  <div
    class:list={[
      "mx-auto flex w-full max-w-[1280px] items-center gap-x-3 px-5 py-3.5 sm:px-10",
      dark ? "border-b border-white/16" : "border-hairline border-b",
    ]}
  >
    <a class="font-display text-[17px] tracking-[-0.02em] no-underline" href="/"
      >digest.law</a
    >
    <span class="flex-1"></span>

    <details class="ald-menu relative" id="site-menu">
      <summary class:list={["cursor-pointer list-none", ...chip]}>
        Menu<span aria-hidden="true" class="ald-menu-caret opacity-50">▾</span>
      </summary>
      <nav
        class:list={[
          "font-ui absolute right-0 z-50 mt-2 flex min-w-[196px] flex-col rounded-[2px] border py-1.5 text-[0.84375rem]",
          dark
            ? "border-white/20 bg-[#000000] text-white"
            : "border-hairline bg-surface text-ink",
        ]}
      >
        {
          links.map(link => (
            <a
              class:list={[
                "px-4 py-2 no-underline",
                dark ? "hover:bg-white/10" : "hover:bg-field",
              ]}
              href={link.href}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </details>

    <a class:list={chip} href="/search/"
      >Search<span class="opacity-50">/</span></a
    >
  </div>
</header>

<style>
  /* Kill the native disclosure triangle in both engines. */
  .ald-menu > summary {
    list-style: none;
  }
  .ald-menu > summary::-webkit-details-marker {
    display: none;
  }
  .ald-menu[open] > summary .ald-menu-caret {
    transform: rotate(180deg);
  }
  .ald-menu-caret {
    display: inline-block;
    transition: transform var(--ald-duration) var(--ald-ease);
  }
  @media (prefers-reduced-motion: reduce) {
    .ald-menu-caret {
      transition: none;
    }
  }
</style>

<script>
  // Keyboard entry to search from anywhere: "/" or Cmd/Ctrl+K.
  function onKey(e: KeyboardEvent) {
    const target = e.target as HTMLElement | null;
    const typing =
      target &&
      (target.tagName === "INPUT" ||
        target.tagName === "TEXTAREA" ||
        target.isContentEditable);
    if (typing) {
      return;
    }
    if (e.key === "/" || ((e.metaKey || e.ctrlKey) && e.key === "k")) {
      if (window.location.pathname === "/search/") {
        return;
      }
      e.preventDefault();
      window.location.href = "/search/";
    }
  }
  document.addEventListener("keydown", onKey);

  /*
   * Menu dismissal. Both listeners are delegated from `document` and re-query
   * the element each time, so they survive View Transitions swaps without
   * needing to be rebound after astro:after-swap.
   */
  function menu(): HTMLDetailsElement | null {
    return document.querySelector<HTMLDetailsElement>("#site-menu");
  }

  document.addEventListener("click", (e: MouseEvent) => {
    const el = menu();
    if (el?.open && !el.contains(e.target as Node)) {
      el.open = false;
    }
  });

  document.addEventListener("keydown", (e: KeyboardEvent) => {
    if (e.key !== "Escape") {
      return;
    }
    const el = menu();
    if (el?.open) {
      el.open = false;
      el.querySelector("summary")?.focus();
    }
  });
</script>
