---
/**
 * The digest page — the core reading experience. Breadcrumbs, title block
 * with SKOS labels, provenance strip, prose with the learnable section TOC,
 * retained-sources block, and the SKOS rail. Fully readable with JS off.
 */
import { render } from "astro:content";
import type { CrumbItem } from "@/components/Crumbs.astro";
import Crumbs from "@/components/Crumbs.astro";
import ProvenanceStrip from "@/components/ProvenanceStrip.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import type { RailRef } from "@/components/SkosRail.astro";
import SkosRail from "@/components/SkosRail.astro";
import Layout from "@/layouts/Layout.astro";
import { channelFor, cleanProfile } from "@/lib/channels";
import { crumbsFor, getCorpus, resolveRef } from "@/lib/corpus";
import { formatBytes, formatDate, humanize } from "@/lib/labels";
import { articleJsonLd, conceptJsonLd } from "@/lib/skos";

interface Props {
  slugPath: string;
}
const { slugPath } = Astro.props,

 corpus = await getCorpus(),
 node = corpus.nodeBySlugPath.get(slugPath);
if (!node?.digest) {
  throw new Error(`No digest at ${slugPath}`);
}
const { digest } = node,
 { dir } = node,
 fm = digest.data,

 { Content, headings } = await render(digest),
 toc = headings
  .filter((h) => h.depth === 1)
  .map((h, i) => ({
    n: String(i + 1).padStart(2, "0"),
    slug: h.slug,
    text: h.text,
  })),

 sources = corpus.sourcesByBundle.get(dir) ?? [],
 audit = corpus.auditsByDir.get(dir),
 caselawIdx = corpus.caselawByDir.get(dir),
 statutoryIdx = corpus.statutoryByDir.get(dir),
 run = corpus.runsByDir.get(dir),

 crumbTrail = crumbsFor(corpus, slugPath),
 crumbs: CrumbItem[] = [
  { href: "/", label: "Digest" },
  ...crumbTrail.slice(0, -1).map((c) => ({
    href: c.published ? `/${c.slugPath}/` : undefined,
    label: c.label,
  })),
  { label: node.label },
],

 generated = formatDate(run?.data.run?.finished_at ?? fm.timestamp),
 profile = cleanProfile(fm.source_profile),

 toRail = (urns: string[]): RailRef[] =>
  urns.map((urn) => resolveRef(corpus, urn)),
 broader = toRail(fm.broader),
 childRefs: RailRef[] = node.children.map((c) => ({
  label: c.label,
  published: true,
  slugPath: c.slugPath,
})),
 narrowerSet = new Map<string, RailRef>();
for (const r of [...toRail(fm.narrower), ...childRefs]) {
  narrowerSet.set(r.slugPath, r);
}
const narrower = [...narrowerSet.values()],
 related = toRail(fm.related),

 relationLabels: Record<string, string> = {
  defenseTo: "defense to",
  procedureFor: "procedure for",
  remedyFor: "remedy for",
},
 relations = Object.entries(fm.legal_relations ?? {})
  .filter(([, urns]) => Array.isArray(urns) && urns.length > 0)
  .map(([key, urns]) => ({
    label: relationLabels[key] ?? key,
    refs: toRail(urns as string[]),
  })),

 mappingLabels: Record<string, string> = {
  eurovoc: "EuroVoc",
  folio: "FOLIO",
  list: "LIST",
  sali_lmss: "SALI/LMSS",
  west_1914: "West 1914",
},
 mappings: { label: string; url?: string; text?: string }[] = [];
for (const [key, group] of Object.entries(fm.mappings ?? {})) {
  if (!group || typeof group !== "object") {
    continue;
  }
  const values = Object.values(group as Record<string, unknown>)
    .flat()
    .filter((v): v is string => typeof v === "string" && v.length > 0);
  if (!values.length) {
    continue;
  }
  const url = values.find((v) => /^https?:\/\//u.test(v));
  mappings.push({
    label: mappingLabels[key] ?? humanize(key),
    text: url ? undefined : values[0],
    url,
  });
}

/** The full SKOS record, for the rail's disclosure — identity and lifecycle
 *  fields as key/value rows, semantic fields as prose. Relations and
 *  mappings already render above it as navigation. */
const itemIds = (fm as Record<string, unknown>)["item_ids"],
 recordRows = [
  { label: "URN", mono: true, value: fm.id ?? "" },
  { label: "Notation", mono: true, value: fm.notation ?? "" },
  { label: "Scheme", value: fm.scheme ?? "" },
  { label: "Status", value: fm.status ?? "" },
  { label: "OKF", mono: true, value: fm.okf_version ?? "" },
  { label: "Version", mono: true, value: fm.version ?? "" },
  { label: "Created", value: fm.created ? formatDate(fm.created) : "" },
  { label: "Modified", value: fm.modified ? formatDate(fm.modified) : "" },
  { label: "Issue ID", mono: true, value: fm.issue_id ?? "" },
  {
    label: "Item IDs",
    mono: true,
    value: Array.isArray(itemIds) ? itemIds.join(" · ") : "",
  },
  { label: "Objectives path", value: fm.objectives_path.join(" → ") },
  { label: "Source profile", value: profile ?? "" },
].filter((r) => r.value),
 recordProse = [
  { label: "Definition", text: fm.definition },
  { label: "Scope", text: fm.scope_note },
  { label: "Not to be used for", text: fm.do_not_use_for.join("; ") },
].filter((r) => r.text),

 areaLabel = crumbTrail[0]?.label ?? "",
 title = `${node.label} — ${areaLabel} — American Legal Digest`,
 description =
  fm.description ||
  fm.definition ||
  `Digest of ${node.label} in ${areaLabel}, with retained sources and audit.`,

 altLine = fm.alt_labels.filter((l) => humanize(l) !== node.label),
 historicalLine = fm.historical_labels,

 sourceUrls = sources
  .map((s) => s.data.resource)
  .filter((u) => /^https?:\/\//u.test(u));
---

<Layout {description} {title}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={conceptJsonLd(corpus, node)} />
    <script
      type="application/ld+json"
      set:html={articleJsonLd(node, {
        description,
        dateModified: fm.modified ?? fm.timestamp,
        sourceUrls,
      })}
    />
  </Fragment>
  <SiteHeader />
  <main class="mx-auto w-full max-w-[1280px] flex-1 px-5 sm:px-10" id="main">
    <div class="pt-7">
      <Crumbs items={crumbs} />
      <h1
        class="font-display mt-5 max-w-[26ch] text-[1.6875rem] leading-[1.08] tracking-[-0.03em] sm:text-[2.625rem]"
      >
        {node.label}
      </h1>
      {(altLine.length > 0 || historicalLine.length > 0) && (
          <div class="font-ui text-ink-muted mt-3 text-[0.8125rem] leading-normal">
            {altLine.length > 0 && (
              <>
                also:{" "}
                {altLine.map((l, i) => (
                  <>
                    {i > 0 && " · "}
                    <em>{l}</em>
                  </>
                ))}
              </>
            )}
            {historicalLine.length > 0 && (
              <>
                {altLine.length > 0 && " "}
                <span class="opacity-70">— formerly:</span>{" "}
                {historicalLine.map((l, i) => (
                  <>
                    {i > 0 && " · "}
                    <em>{l}</em>
                  </>
                ))}
              </>
            )}
          </div>
        )}
      {description && (
          <p class="font-prose text-ink/78 mt-4 max-w-[62ch] text-[1.0625rem] leading-normal sm:text-[1.25rem]">
            {description}
          </p>
        )}
      <div class="mt-5">
        <ProvenanceStrip
          {generated}
          links={{
            sources: sources.length ? `#retained-sources` : undefined,
            audit: audit ? `/${slugPath}/audit/` : undefined,
            caselaw: caselawIdx ? `/${slugPath}/caselaw/` : undefined,
            statutory: statutoryIdx ? `/${slugPath}/statutory/` : undefined,
            run: run ? `/provenance/${slugPath}.json` : undefined,
          }}
          preProvenance={!run}
          {profile}
          sourceCount={sources.length}
        />
      </div>
    </div>

    <div class="grid gap-x-14 pt-2 pb-12 lg:grid-cols-[minmax(0,1fr)_268px]">
      <div class="min-w-0">
        <span class="hidden" data-pagefind-filter="area">{areaLabel}</span>
        <span class="hidden" data-pagefind-filter="kind">digest</span>
        <article class="ald-prose" data-pagefind-body>
          <Content />
        </article>

        {sources.length > 0 && (
            <section
              id="retained-sources"
              class="border-ink mt-10 border-t pt-4"
              data-pagefind-ignore
            >
              <div class="mb-1.5 flex items-baseline gap-3">
                <span class="ald-meta text-[0.65625rem]">
                  Retained sources — {sources.length}
                </span>
                <span class="flex-1" />
                <span class="ald-meta text-ink-muted hidden text-[0.5625rem] sm:inline">
                  The evidence this digest rests on, preserved as retained
                </span>
              </div>
              {sources.map((s, i) => (
                <a
                  href={`/${slugPath}/sources/${s.data.slug}/`}
                  class="border-hairline/70 flex items-baseline gap-3.5 border-t py-2.5 text-inherit no-underline"
                >
                  <span class="ald-meta text-ink-muted w-6 flex-none text-[0.59375rem]">
                    S{i + 1}
                  </span>
                  <span class="font-prose min-w-0 text-[1.03125rem] leading-snug">
                    {s.data.description || s.data.title}
                    <span class="ald-held" />
                  </span>
                  <span class="flex-1" />
                  <span class="ald-meta text-ink-muted text-[0.5625rem] whitespace-nowrap">
                    {channelFor(s.data.resource)} · {formatBytes(s.data.bytes)}
                    {s.data.retained &&
                      ` · retained ${formatDate(s.data.retained)}`}
                  </span>
                </a>
              ))}
            </section>
          )}
      </div>

      <aside class="pt-8 lg:pt-7" data-pagefind-ignore>
        <div class="lg:sticky lg:top-6">
          <SkosRail
            {broader}
            {mappings}
            {narrower}
            record={{ rows: recordRows, prose: recordProse }}
            {related}
            {relations}
            {toc}
          />
        </div>
      </aside>
    </div>
  </main>
  <SiteFooter />
</Layout>
