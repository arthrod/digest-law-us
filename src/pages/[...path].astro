---
/**
 * One route, the whole corpus mirror: /{area}/…/{topic}/ digests, area and
 * container listings, per-bundle /audit/, /caselaw/, /statutory/, and
 * /sources/{slug}/ with /2/…/n/ chunk continuations. URLs are the
 * lowercase-kebab mirror of the corpus tree — stable, citable.
 */

import AreaView from "@/components/views/AreaView.astro";
import AuditView from "@/components/views/AuditView.astro";
import ContainerView from "@/components/views/ContainerView.astro";
import DigestView from "@/components/views/DigestView.astro";
import IndexView from "@/components/views/IndexView.astro";
import SourceView from "@/components/views/SourceView.astro";
import { cacheKeyFrom, stampEntry, stampRef, subtreeStamps } from "@/lib/cache-keys";
import { getCorpus, resolveRef } from "@/lib/corpus";

export async function getStaticPaths() {
  const corpus = await getCorpus();
  interface PathSpec {
    cacheKey: string;
    params: { path: string };
    props: {
      kind:
        | "digest"
        | "area"
        | "container"
        | "audit"
        | "caselaw"
        | "statutory"
        | "source";
      slugPath: string;
      sourceId?: string;
      part?: number;
    };
  }
  const paths: PathSpec[] = [];

  /**
   * Incremental-build cache keys (see lib/cache-keys.ts for the contract).
   * Astro's own tracking covers the route's code and the entries a page
   * `render()`s; each key below covers the rest of that page's data inputs.
   * Missing an input here ships a stale page with no error, so keys err
   * over-inclusive.
   */

  // AreaView's adjacency chips read other areas' labels and topic counts,
  // so every area page keys on the full root list. 43 roots — re-rendering
  // them all when one count moves is noise; missing the change is not.
  const areaRollCall = corpus.areas.map(
    (a) => `a:${a.slugPath}#${a.topicCount}#${a.label}`
  );

  for (const node of corpus.nodeBySlugPath.values()) {
    const isArea = !node.slugPath.includes("/");
    const { dir } = node;
    const sources = corpus.sourcesByBundle.get(dir) ?? [];
    const audit = corpus.auditsByDir.get(dir);
    const caselawIdx = corpus.caselawByDir.get(dir);
    const statutoryIdx = corpus.statutoryByDir.get(dir);
    const run = corpus.runsByDir.get(dir);

    if (node.digest) {
      // The SKOS rail resolves refs against the whole corpus: a target
      // digest appearing elsewhere flips its link to published, so the
      // resolution state of every ref is an input of this page.
      const fm = node.digest.data;
      const refUrns = [
        ...fm.broader,
        ...fm.narrower,
        ...fm.related,
        ...Object.values(fm.legal_relations ?? {}).flatMap((urns) =>
          Array.isArray(urns) ? urns : []
        ),
      ];
      paths.push({
        cacheKey: cacheKeyFrom("digest", [
          stampEntry(node.digest),
          ...sources.map(stampEntry),
          stampEntry(audit),
          stampEntry(caselawIdx),
          stampEntry(statutoryIdx),
          stampEntry(run),
          ...refUrns.map((urn) => stampRef(resolveRef(corpus, urn))),
          ...node.children.map((c) => `c:${c.slugPath}#${c.label}`),
        ]),
        params: { path: node.slugPath },
        props: { kind: "digest", slugPath: node.slugPath },
      });
    } else {
      paths.push({
        cacheKey: cacheKeyFrom(isArea ? "area" : "container", [
          ...subtreeStamps(node, corpus.sourcesByBundle),
          ...(isArea ? areaRollCall : []),
        ]),
        params: { path: node.slugPath },
        props: { kind: isArea ? "area" : "container", slugPath: node.slugPath },
      });
    }

    if (!node.digest) {
      continue;
    }
    if (audit) {
      paths.push({
        cacheKey: cacheKeyFrom("audit", [
          stampEntry(audit),
          stampEntry(run),
          ...sources.map(stampEntry),
        ]),
        params: { path: `${node.slugPath}/audit` },
        props: { kind: "audit", slugPath: node.slugPath },
      });
    }
    if (caselawIdx) {
      paths.push({
        cacheKey: cacheKeyFrom("caselaw", [
          stampEntry(caselawIdx),
          stampEntry(run),
          stampEntry(audit),
        ]),
        params: { path: `${node.slugPath}/caselaw` },
        props: { kind: "caselaw", slugPath: node.slugPath },
      });
    }
    if (statutoryIdx) {
      paths.push({
        cacheKey: cacheKeyFrom("statutory", [
          stampEntry(statutoryIdx),
          stampEntry(run),
          stampEntry(audit),
        ]),
        params: { path: `${node.slugPath}/statutory` },
        props: { kind: "statutory", slugPath: node.slugPath },
      });
    }
    for (const source of sources) {
      // SourceView reads the retained file straight from disk (never through
      // render()), shows prev/next siblings, and prints run.json checksums —
      // all of it keyed. The entry digest tracks the file's content via the
      // loader's contentSha.
      const sourceKeyParts = [
        stampEntry(source),
        ...sources.map(stampEntry),
        stampEntry(run),
        stampEntry(node.digest),
      ];
      for (let part = 1; part <= source.data.parts; part += 1) {
        paths.push({
          cacheKey: cacheKeyFrom(`source:${part}`, sourceKeyParts),
          params: {
            path:
              part === 1
                ? `${node.slugPath}/sources/${source.data.slug}`
                : `${node.slugPath}/sources/${source.data.slug}/${part}`,
          },
          props: {
            kind: "source",
            part,
            slugPath: node.slugPath,
            sourceId: source.id,
          },
        });
      }
    }
  }
  return paths;
}

const { kind, slugPath, sourceId, part } = Astro.props;
---

{kind === "digest" && <DigestView {slugPath} />}
{kind === "area" && <AreaView {slugPath} />}
{kind === "container" && <ContainerView {slugPath} />}
{kind === "audit" && <AuditView {slugPath} />}
{(kind === "caselaw" || kind === "statutory") && (
    <IndexView {slugPath} kind={kind} />
  )}
{kind === "source" && (
    <SourceView {slugPath} sourceId={sourceId!} part={part!} />
  )}
