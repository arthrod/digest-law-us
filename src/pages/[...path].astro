---
/**
 * One route, the whole corpus mirror: /{area}/…/{topic}/ digests, area and
 * container listings, per-bundle /audit/, /caselaw/, /statutory/, and
 * /sources/{slug}/ with /2/…/n/ chunk continuations. URLs are the
 * lowercase-kebab mirror of the corpus tree — stable, citable.
 */
import { getCorpus } from "@/lib/corpus";
import DigestView from "@/components/views/DigestView.astro";
import AreaView from "@/components/views/AreaView.astro";
import ContainerView from "@/components/views/ContainerView.astro";
import SourceView from "@/components/views/SourceView.astro";
import AuditView from "@/components/views/AuditView.astro";
import IndexView from "@/components/views/IndexView.astro";

export async function getStaticPaths() {
  const corpus = await getCorpus();
  type PathSpec = {
    params: { path: string };
    props: {
      kind: "digest" | "area" | "container" | "audit" | "caselaw" | "statutory" | "source";
      slugPath: string;
      sourceId?: string;
      part?: number;
    };
  };
  const paths: PathSpec[] = [];

  for (const node of corpus.nodeBySlugPath.values()) {
    const isArea = !node.slugPath.includes("/");
    if (node.digest) {
      paths.push({
        params: { path: node.slugPath },
        props: { kind: "digest", slugPath: node.slugPath },
      });
    } else {
      paths.push({
        params: { path: node.slugPath },
        props: { kind: isArea ? "area" : "container", slugPath: node.slugPath },
      });
    }

    if (!node.digest) continue;
    const dir = node.dir;
    if (corpus.auditsByDir.has(dir)) {
      paths.push({
        params: { path: `${node.slugPath}/audit` },
        props: { kind: "audit", slugPath: node.slugPath },
      });
    }
    if (corpus.caselawByDir.has(dir)) {
      paths.push({
        params: { path: `${node.slugPath}/caselaw` },
        props: { kind: "caselaw", slugPath: node.slugPath },
      });
    }
    if (corpus.statutoryByDir.has(dir)) {
      paths.push({
        params: { path: `${node.slugPath}/statutory` },
        props: { kind: "statutory", slugPath: node.slugPath },
      });
    }
    for (const source of corpus.sourcesByBundle.get(dir) ?? []) {
      for (let part = 1; part <= source.data.parts; part++) {
        paths.push({
          params: {
            path:
              part === 1
                ? `${node.slugPath}/sources/${source.data.slug}`
                : `${node.slugPath}/sources/${source.data.slug}/${part}`,
          },
          props: {
            kind: "source",
            slugPath: node.slugPath,
            sourceId: source.id,
            part,
          },
        });
      }
    }
  }
  return paths;
}

const { kind, slugPath, sourceId, part } = Astro.props;
---

{kind === "digest" && <DigestView {slugPath} />}
{kind === "area" && <AreaView {slugPath} />}
{kind === "container" && <ContainerView {slugPath} />}
{kind === "audit" && <AuditView {slugPath} />}
{
  (kind === "caselaw" || kind === "statutory") && (
    <IndexView {slugPath} kind={kind} />
  )
}
{
  kind === "source" && (
    <SourceView {slugPath} sourceId={sourceId!} part={part!} />
  )
}
