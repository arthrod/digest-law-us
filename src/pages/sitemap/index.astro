---
/**
 * The corpus map: every area, each linking to its own full tree at
 * /sitemap/<area>/. One page holding every tree outgrew the 25 MiB
 * static-asset cap (36 MB at 24,862 digests), so the trees live per area.
 */

import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import Layout from "@/layouts/Layout.astro";
import { getCorpus } from "@/lib/corpus";

/* oxlint-disable eslint/sort-vars -- description calls fmt at init; sorting would hit the TDZ */
const corpus = await getCorpus(),
 fmt = (n: number) => n.toLocaleString("en-US"),

 title = "Sitemap — American Legal Digest",
 description = `The full topic tree: ${fmt(corpus.stats.digests)} digests across ${corpus.stats.areas} areas of United States law.`;
/* oxlint-enable eslint/sort-vars */
---

<Layout {description} {title}>
  <SiteHeader />
  <main class="mx-auto w-full max-w-[900px] flex-1 px-5 sm:px-9" id="main">
    <div class="pt-8 pb-11">
      <h1
        class="font-display text-[1.75rem] leading-[1.1] tracking-[-0.03em] sm:text-[2.25rem]"
      >
        The full map
      </h1>
      <div class="ald-meta text-ink-muted mt-3">
        {`${corpus.stats.areas} areas · ${fmt(corpus.stats.digests)} digests · machine sitemap at`}
        <a
          class="decoration-cite-ext underline underline-offset-2"
          href="/sitemap-index.xml"
          >/sitemap-index.xml</a
        >
      </div>
      {corpus.areas.map(area => (
          <a
            class="border-hairline mt-5 flex items-baseline gap-3 border-t py-3 no-underline hover:opacity-70"
            href={`/sitemap/${area.slugPath}/`}
          >
            <span class="font-display text-[1.3125rem] leading-tight tracking-[-0.02em]">
              {area.label}
            </span>
            <span class="flex-1" />
            <span class="ald-meta text-ink-muted text-[0.625rem]">
              {area.topicCount} topic{area.topicCount === 1 ? "" : "s"}
            </span>
          </a>
        ))}
    </div>
  </main>
  <SiteFooter />
</Layout>
