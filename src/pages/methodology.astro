---
/**
 * Methodology — how digests are made: pipeline, evidence floor, and the
 * purge as brand. The pipeline is honest by construction — it publishes
 * what it can prove and deletes what it cannot.
 */

import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import Layout from "@/layouts/Layout.astro";
import { getCorpus } from "@/lib/corpus";
import { formatBytes, formatDate } from "@/lib/labels";
import { getPurge } from "@/lib/purge";

const corpus = await getCorpus();
const { stats } = corpus;
const purge = await getPurge();
const fmt = (n: number) => n.toLocaleString("en-US");

const steps = [
  {
    body: "Free public channels only. Every query and hit count is logged to the audit.",
    chips: ["CourtListener", "GovInfo", "eCFR", "Cornell LII", "Direct fetch"],
    n: "01",
    name: "Search",
  },
  {
    body: "Accepted texts are preserved in full and hashed. Rejections are recorded with their technical reason — paywalled, duplicate, non-authoritative, conversion failed.",
    n: "02",
    name: "Retain",
  },
  {
    body: "The digest is written from retained texts alone, in a fixed section structure. The model chain is recorded in run.json — the disclosure every page carries.",
    n: "03",
    name: "Draft",
  },
  {
    body: `Merge is blocked unless the floor holds: at least two retained sources, both indexes generated (or their absence documented), audit complete. The ${stats.preProvenance} June-2026 bundles that predate provenance capture are disclosed as such — never backfilled.`,
    n: "04",
    name: "Review gate",
  },
  {
    body: "Digest, full source texts, audit, and run.json ship together at a stable URL — the permanent identifier lives at w3id.org/digest-law/us/. Corrections are new commits, not silent edits.",
    n: "05",
    name: "Publish",
  },
];

/**
 * Headline grid, built as data so the purge tile disappears with its
 * manifest rather than showing a number nothing backs. Borders track
 * position (see the same pattern on /about/).
 */
const tiles = [
  { label: "Digests published", value: fmt(stats.digests) },
  ...(purge.latest
    ? [{ label: "Deleted at the floor", value: fmt(purge.total) }]
    : []),
  { label: "Pre-provenance — disclosed", value: String(stats.preProvenance) },
  {
    label: `Source texts held — ${formatBytes(stats.sourceBytes)}`,
    value: fmt(stats.sources),
  },
];

const tileClass = (i: number) => {
  if (i === 0) {
    return "pt-4.5 pr-5";
  }
  return i % 2 === 1
    ? "border-hairline border-l px-5 pt-4.5"
    : "sm:border-hairline pt-4.5 pr-5 sm:border-l sm:px-5";
};

const purgeTail = purge.latest
  ? ` — and ${fmt(purge.total)} thin digests deleted rather than shipped.`
  : ".";

const title = "Methodology — American Legal Digest";
const description = `How digests are made: free public sources only, a two-source evidence floor, published audits${purgeTail}`;
---

<Layout {description} {title}>
  <SiteHeader />
  <main class="mx-auto w-full max-w-250 flex-1 px-5 sm:px-9" id="main">
    <div class="pt-9 pb-11">
      <h1
        class="font-display text-[1.75rem] leading-[1.1] tracking-[-0.03em] sm:text-[2.25rem]"
      >
        How digests are made
      </h1>
      <p
        class="font-prose text-ink/78 mt-3.5 max-w-[58ch] text-[1.09375rem] leading-[1.55] sm:text-[1.1875rem]"
      >
        The pipeline is honest by construction — it publishes what it can prove
        and deletes what it cannot.
      </p>

      <div class="border-ink mt-8 border-t">
        {steps.map(step => (
            <div class="border-hairline grid grid-cols-[40px_1fr] gap-x-6 border-b py-4 sm:grid-cols-[52px_210px_1fr]">
              <span class="ald-meta text-[0.6875rem]">{step.n}</span>
              <span class="font-display text-[1.25rem] leading-tight tracking-[-0.02em]">
                {step.name}
              </span>
              <div class="col-span-2 mt-2 sm:col-span-1 sm:mt-0">
                <p class="font-ui text-ink/75 m-0 text-[0.875rem] leading-relaxed">
                  {step.body}
                </p>
                {step.chips && (
                  <div class="ald-meta text-ink/65 mt-2 flex flex-wrap gap-1.5 text-[0.53125rem]">
                    {step.chips.map(chip => (
                      <span class="border-hairline rounded-[2px] border px-2 py-1">
                        {chip}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          ))}
      </div>

      <p class="ald-meta text-ink-muted mt-4 max-w-[74ch] text-[0.59375rem] leading-[1.7]">
        Step 04 is people, not a script. The
        <a
          class="decoration-cite-ext underline underline-offset-2"
          href="/committee/">review committee</a
        > is named, and it is
        <a
          class="decoration-cite-ext underline underline-offset-2"
          href="/contact/?topic=reviewer">looking for local and global reviewers</a
        >.
      </p>

      <div class="border-l-accent mt-9 border-l-2 py-1.5 pl-6" id="the-floor">
        {purge.latest ? (
          <>
            <div class="font-display max-w-[26ch] text-[1.5rem] leading-[1.2] tracking-[-0.03em] sm:text-[1.875rem]">
              We deleted {fmt(purge.total)} digest{purge.total === 1 ? "" : "s"}
              {" "}rather than publish them thin.
            </div>
            <div class="ald-meta text-ink-muted mt-3 text-[0.59375rem]">
              {purge.events.length === 1
                ? `Purge of ${formatDate(purge.latest.date)}`
                : `${purge.events.length} purges, latest ${formatDate(purge.latest.date)}`}
              {" "}— the evidence floor, enforced
            </div>
          </>
        ) : (
          <>
            <div class="font-display max-w-[26ch] text-[1.5rem] leading-[1.2] tracking-[-0.03em] sm:text-[1.875rem]">
              A digest that cannot clear the floor is deleted, not padded.
            </div>
            <div class="ald-meta text-ink-muted mt-3 text-[0.59375rem]">
              The evidence floor, enforced — deletion manifest not available at
              build time
            </div>
          </>
        )}
      </div>

      <div
        class="border-hairline mt-8 grid grid-cols-2 border-t sm:grid-cols-4"
      >
        {tiles.map((tile, i) => (
            <div class={tileClass(i)}>
              <div class="font-display text-[1.625rem] leading-none tabular-nums">
                {tile.value}
              </div>
              <div class="ald-meta text-ink-muted mt-2 text-[0.53125rem]">
                {tile.label}
              </div>
            </div>
          ))}
      </div>

      <div class="ald-meta text-ink-muted mt-9 max-w-[74ch] leading-[1.8]">
        Digests are machine-generated and machine-reviewed; they are a map of
        doctrine pointing at authorities, not a treatise, and not legal advice.
        Permanent identifiers:
        <a
          class="decoration-cite-ext underline underline-offset-2"
          href="https://w3id.org/digest-law/us/"
          >w3id.org/digest-law/us/</a
        >. Machine-readable scheme:
        <a
          class="decoration-cite-ext underline underline-offset-2"
          href="/skos.jsonld"
          >SKOS JSON-LD</a
        >. Companion vocabulary:
        <a
          class="decoration-cite-ext underline underline-offset-2"
          href="https://w3id.org/legal-taxonomy/"
          >Open Legal Issue Taxonomy</a
        >.
      </div>
    </div>
  </main>
  <SiteFooter />
</Layout>
