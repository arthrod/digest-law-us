---
/**
 * About — what this project is, what it is made of, what it is honestly not,
 * and how to check any of it. Every number is read from the corpus at build
 * time, so the page cannot drift from the thing it describes.
 */

import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import Layout from "@/layouts/Layout.astro";
import { getCorpus } from "@/lib/corpus";
import { formatBytes } from "@/lib/labels";
import { getPurge } from "@/lib/purge";

const corpus = await getCorpus(),
 { doctrinalAreas, compositeAreas, stats } = corpus,
 purge = await getPurge(),
 fmt = (n: number) => n.toLocaleString("en-US"),

/** Counts are composed into sentences here, not inline in the template —
 *  JSX strips whitespace across newlines (see the note in index.astro). */
 lede =
  `${fmt(stats.digests)} topic digests of United States legal doctrine. ` +
  "Each is published with the full text of the authorities behind it, the " +
  "log of every search that produced it, and the manifest of the run that " +
  "wrote it. The digests are CC BY 4.0; the classification is SKOS with " +
  "permanent identifiers; the method is written down so it can be repeated.",

 bundle = [
  {
    body: "The digest itself: a fixed structure of twelve sections, drafted from the retained texts and from nothing else. Its frontmatter is a SKOS concept — labels, definition, scope note, hierarchy, and mappings.",
    name: "The digest",
  },
  {
    body: "Every retained source, in full, at the same address as the summary. Long texts paginate into real routed pages rather than one unusable file. Byte-faithful except for three declared conversions: HTML to Markdown, PDF text extraction, and identification frontmatter.",
    name: "The sources",
  },
  {
    body: "The audit: every query run with its hit count, every source retained, and every candidate rejected with a technical reason — paywalled, duplicate, non-authoritative, conversion failed. Where a search found nothing, the absence is recorded with the queries that produced it.",
    name: "The audit",
  },
  {
    body: "Tables of authorities for caselaw and statutes, derived by parsing the digest's own citations — never written by the model. Where there is nothing to list, the table records the probe queries and their zero counts instead of appearing empty.",
    name: "The indexes",
  },
  {
    body: "run.json: the generation manifest. It pins the issue ledger and the researcher prompt by sha256, and records the provider chain, retriever, scraper, search depth and breadth, timings, and runner version.",
    name: "The manifest",
  },
],

 purgeClause = purge.latest
  ? ` ${fmt(purge.total)} digests that failed the floor were deleted, and those dated deletion manifests are where that number comes from.`
  : "",

 claims = [
  `Every published digest holds at least two retained authorities, in full, at the same URL as the summary — counted from the files on disk, not from a bundle's own metadata.${purgeClause}`,
  "Digests are machine-drafted from retained texts and gated by review before merge. The models are named in each manifest. Nothing here was written by a lawyer, and the site never says otherwise.",
  "No claim of validated quality is made. Every automated gate checks integrity — hierarchy, identity, reproduction — never whether a placement or a proposition is legally correct. The validation stage is pre-registered and blocked on independent qualified reviewers.",
  "Coverage is uneven, and the shape of it is knowable: the source corpus is roughly 85% published between 1830 and 1930, so the common-law doctrinal core is dense and the modern regulatory state is thin. Procedure, property, and obligations dominate; administrative, health, environmental, technology, and civil-rights material is sparse.",
  "Only free public sources were used. Paywalled reporters and subscription databases are excluded by an enforced rule, which leaves real gaps rather than hidden ones.",
  "Nothing here is legal advice. A digest maps doctrine and points at authorities; judgment about a matter belongs to a lawyer engaged on it.",
],

 tiles = [
  { label: "Topics digested", value: fmt(stats.digests) },
  {
    label: "Doctrinal areas + cross-cutting roots",
    value: `${doctrinalAreas.length} + ${compositeAreas.length}`,
  },
  {
    label: `Source texts held — ${formatBytes(stats.sourceBytes)}`,
    value: fmt(stats.sources),
  },
  ...(purge.latest
    ? [
        {
          label: "Deleted below the evidence floor",
          value: fmt(purge.total),
        },
      ]
    : []),
],

 tileClass = (i: number) => {
  if (i === 0) {
    return "pt-4.5 pr-5";
  }
  return i % 2 === 1
    ? "border-hairline border-l px-5 pt-4.5"
    : "sm:border-hairline pt-4.5 pr-5 sm:border-l sm:px-5";
},

 title = "About — American Legal Digest",
 description =
  "An open digest of United States legal doctrine: a SKOS classification built from public-domain treatise structure, researched from free public sources, and published with full source texts, search logs, and generation manifests.";
---

<Layout {description} {title}>
  <SiteHeader />
  <main class="mx-auto w-full max-w-250 flex-1 px-5 sm:px-9" id="main">
    <div class="pt-9 pb-11">
      <div class="ald-meta text-ink-muted mb-4 text-[0.6875rem]">
        About the project
      </div>
      <h1
        class="font-display max-w-[22ch] text-[1.75rem] leading-[1.1] tracking-[-0.03em] sm:text-[2.25rem]"
      >
        An open digest of American law
      </h1>
      <p
        class="font-prose text-ink/78 mt-3.5 max-w-[58ch] text-[1.09375rem] leading-[1.55] sm:text-[1.1875rem]"
      >
        {lede}
      </p>

      <!-- What is actually here -->
      <div
        class="border-hairline mt-9 grid grid-cols-2 border-t sm:grid-cols-4"
      >
        {tiles.map((tile, i) => (
            <div class={tileClass(i)}>
              <div class="font-display text-[1.625rem] leading-none tabular-nums">
                {tile.value}
              </div>
              <div class="ald-meta text-ink-muted mt-2 text-[0.53125rem]">
                {tile.label}
              </div>
            </div>
          ))}
      </div>

      <!-- Why it exists -->
      <div class="mt-12">
        <div class="ald-meta text-[0.6875rem]">01 | Why it exists</div>
        <div class="border-ink mt-3 border-t pt-5">
          <p
            class="font-prose text-ink/80 m-0 max-w-[64ch] text-[1.0625rem] leading-[1.62]"
          >
            The common law states its doctrine in cases, so finding the law
            means connecting cases. The apparatus built for that work — topics,
            key numbers, headnotes written by attorney-editors — has organized
            American case law since the 1890s. It is excellent, and it is
            proprietary. A lawyer without a subscription meets doctrine in two
            forms: summaries that cannot be verified, and primary sources that
            cannot be reached.
          </p>
          <p
            class="font-prose text-ink/80 mt-4 max-w-[64ch] text-[1.0625rem] leading-[1.62]"
          >
            There is no code to consult instead. That absence is not an
            oversight of American law; it is its design, and the digest was the
            profession's answer to it — a classification of the whole case law
            so a practitioner could find the point of law rather than the case.
            This project rebuilds that answer as public infrastructure: an open
            classification, summaries that carry their sources, and the
            research behind each summary — the queries, the hits, the
            rejections — retained and published rather than discarded as a
            byproduct.
          </p>
        </div>
      </div>

      <!-- Where it comes from -->
      <div class="mt-12">
        <div class="ald-meta text-[0.6875rem]">02 | Where it comes from</div>
        <div class="border-ink mt-3 border-t pt-5">
          <p
            class="font-prose text-ink/80 m-0 max-w-[64ch] text-[1.0625rem] leading-[1.62]"
          >
            The classification was not designed at a desk. It was read out of
            the profession's own literature: public-domain American treatises,
            openly licensed casebooks, and pre-1931 Restatement drafts, from
            which 351,115 section headings were extracted and classified. The
            heading is the unit
            because it is where a treatise author decided that a point of law
            deserved its own section. Tables of contents and section headings,
            never back-of-book indexes: the structure is the doctrinal
            hierarchy, and copying no work's index arrangement keeps the result
            clean.
          </p>
          <p
            class="font-prose text-ink/80 mt-4 max-w-[64ch] text-[1.0625rem] leading-[1.62]"
          >
            Those headings became the Open Legal Issue Taxonomy — 287,715 SKOS
            concepts, published with permanent identifiers — and then, anchored
            to the FOLIO ontology under two roots, 137,139 canonical legal
            issues. This site is what happens when a research runner works
            through those issues one at a time. The full method, its
            thresholds, and the failures that shaped it are on the
            <a
              class="decoration-cite-ext underline underline-offset-2"
              href="/methodology/">methodology page</a
            >, and the same method written for another legal system to run is
            the
            <a
              class="decoration-cite-ext underline underline-offset-2"
              href="/protocol/">replication protocol</a
            >.
          </p>
        </div>
      </div>

      <!-- What a digest is made of -->
      <div class="mt-12">
        <div class="ald-meta text-[0.6875rem]">03 | What ships with a digest</div>
        <div class="border-ink mt-3 border-t">
          {bundle.map(item => (
              <div class="border-hairline grid grid-cols-[1fr] gap-x-6 border-b py-4 sm:grid-cols-[230px_1fr]">
                <span class="font-display text-[1.25rem] leading-tight tracking-[-0.02em]">
                  {item.name}
                </span>
                <div class="mt-2 sm:mt-0">
                  <p class="font-ui text-ink/75 m-0 text-[0.875rem] leading-relaxed">
                    {item.body}
                  </p>
                </div>
              </div>
            ))}
        </div>
        <p class="ald-meta text-ink-muted mt-4 max-w-[74ch] text-[0.59375rem] leading-[1.7]">
          To judge a digest, open its audit before its prose. A digest whose
          audit is thin is thin, and the page will not disguise it.
        </p>
      </div>

      <div class="border-l-accent mt-9 border-l-2 py-1.5 pl-6">
        <div
          class="font-display max-w-[30ch] text-[1.5rem] leading-[1.2] tracking-[-0.03em] sm:text-[1.875rem]"
        >
          Every claim on this site is published next to the record that
          supports it.
        </div>
        <div class="ald-meta text-ink-muted mt-3 text-[0.59375rem]">
          Sources in full, audits with their rejections, a manifest per bundle
        </div>
      </div>

      <!-- What is claimed -->
      <div class="mt-12">
        <div class="ald-meta text-[0.6875rem]">
          04 | What is claimed, and what is not
        </div>
        <div class="border-ink mt-3 border-t">
          {claims.map(text => (
              <div class="border-hairline flex gap-4 border-b py-3.5">
                <span class="text-ink-muted mt-[0.4em] leading-none">—</span>
                <p class="font-ui text-ink/75 m-0 max-w-[70ch] text-[0.875rem] leading-relaxed">
                  {text}
                </p>
              </div>
            ))}
        </div>
      </div>

      <!-- Who stands behind it -->
      <div class="mt-12">
        <div class="ald-meta text-[0.6875rem]">05 | Who stands behind it</div>
        <div class="border-ink mt-3 border-t pt-5">
          <p
            class="font-prose text-ink/80 m-0 max-w-[64ch] text-[1.0625rem] leading-[1.62]"
          >
            The editor and reviewers are named on the
            <a
              class="decoration-cite-ext underline underline-offset-2"
              href="/committee/">committee page</a
            >. Corrections ship as new commits carrying the record of what
            changed. The work that remains — topical relevance gating,
            deterministic floor enforcement, and above all the validation
            stage — is listed publicly with its status, blocked on people
            rather than on design. Qualified reviewers, institutional
            partners, and sponsors turn those gates into milestones.
          </p>
          <div class="ald-meta mt-5 flex flex-wrap gap-2 text-[0.59375rem]">
            <a
              class="border-hairline hover:border-ink rounded-[2px] border px-3 py-2 no-underline"
              href="/methodology/"
              >Methodology ↗</a
            >
            <a
              class="border-hairline hover:border-ink rounded-[2px] border px-3 py-2 no-underline"
              href="/protocol/"
              >Replication protocol ↗</a
            >
            <a
              class="border-hairline hover:border-ink rounded-[2px] border px-3 py-2 no-underline"
              href="/sitemap/"
              >Full area map ↗</a
            >
            <a
              class="border-hairline hover:border-ink rounded-[2px] border px-3 py-2 no-underline"
              href="/committee/"
              >Review committee ↗</a
            >
            <a
              class="border-hairline hover:border-ink rounded-[2px] border px-3 py-2 no-underline"
              href="/contact/?topic=reviewer"
              >Become a reviewer ↗</a
            >
            <a
              class="border-hairline hover:border-ink rounded-[2px] border px-3 py-2 no-underline"
              href="/contact/?topic=correction"
              >Report a correction ↗</a
            >
          </div>
        </div>
      </div>

      <!-- Provenance -->
      <div class="ald-meta text-ink-muted mt-12 max-w-[74ch] leading-[1.8]">
        Digest text is licensed
        <a
          class="decoration-cite-ext underline underline-offset-2"
          href="https://creativecommons.org/licenses/by/4.0/"
          rel="license"
          >CC BY 4.0</a
        >. Retained sources are public domain or as-licensed by their
        publishers (17 U.S.C. § 105; <em>Georgia v. Public.Resource.Org</em>,
        590 U.S. 255 (2020)). Permanent identifiers live at
        <a
          class="decoration-cite-ext underline underline-offset-2"
          href="https://w3id.org/digest-law/us/"
          >w3id.org/digest-law/us/</a
        >, the machine-readable scheme at
        <a
          class="decoration-cite-ext underline underline-offset-2"
          href="/skos.jsonld"
          >SKOS JSON-LD</a
        >, and the companion vocabulary at
        <a
          class="decoration-cite-ext underline underline-offset-2"
          href="https://w3id.org/legal-taxonomy/"
          >Open Legal Issue Taxonomy</a
        >. Site code:
        <a
          class="decoration-cite-ext underline underline-offset-2"
          href="https://github.com/arthrod/digest-law-us"
          >github.com/arthrod/digest-law-us</a
        >. Last corpus update: {stats.latest}.
      </div>
    </div>
  </main>
  <SiteFooter />
</Layout>
