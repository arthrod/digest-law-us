---
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Not found — American Legal Digest">
  <SiteHeader />
  <main class="mx-auto w-full max-w-[900px] flex-1 px-5 sm:px-9" id="main">
    <div class="pt-16 pb-14">
      <div class="ald-meta text-ink-muted mb-4">404 — no page here</div>
      <h1
        class="font-display max-w-[26ch] text-[1.75rem] leading-[1.12] tracking-[-0.03em] sm:text-[2.25rem]"
      >
        Nothing is published at this address.
      </h1>
      <p
        class="font-ui text-ink-muted mt-4 max-w-[62ch] text-[0.9375rem] leading-relaxed"
      >
        The topic may not have cleared the evidence floor yet — only digests
        holding at least two retained sources are published. Try the area
        directory, the full map, or search.
      </p>
      <div class="mt-7 flex flex-wrap gap-2">
        <a class="ald-chip" href="/">All areas</a>
        <a class="ald-chip" href="/sitemap/">Sitemap</a>
        <a class="ald-chip" href="/search/">Search</a>
        <a class="ald-chip" href="/methodology/">Methodology</a>
      </div>
    </div>
  </main>
  <SiteFooter />
</Layout>
