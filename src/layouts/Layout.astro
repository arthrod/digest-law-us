---
import { ClientRouter } from "astro:transitions";
import SITE from "@/config";
import "@/styles/global.css";

interface Props {
  canonicalURL?: string;
  description?: string;
  ogImage?: string;
  title?: string;
}

const {
  title = SITE.title,
  description = SITE.description,
  ogImage = `/${SITE.ogImage}`,
  canonicalURL = new URL(Astro.url.pathname, Astro.site).href,
} = Astro.props,

 socialImageURL = new URL(ogImage, Astro.site ?? Astro.url);
---

<!doctype html>
<html class="overflow-y-scroll scroll-smooth" lang={SITE.lang}>
  <head>
    <meta charset="UTF-8">
    <meta content="width=device-width, initial-scale=1" name="viewport">
    <link href="/favicon.svg" rel="icon" type="image/svg+xml">
    <link href={canonicalURL} rel="canonical">
    <meta content={Astro.generator} name="generator">

    <!-- Brand webfonts (subset woff2, font-display: swap) -->
    <link
      as="font"
      crossorigin
      href="/fonts/eliza.woff2"
      rel="preload"
      type="font/woff2"
    >
    <link
      as="font"
      crossorigin
      href="/fonts/basier-square.woff2"
      rel="preload"
      type="font/woff2"
    >
    <link
      as="font"
      crossorigin
      href="/fonts/basier-square-mono.woff2"
      rel="preload"
      type="font/woff2"
    >

    <!-- Primary meta -->
    <title>{title}</title>
    <meta content={title} name="title">
    <meta content={description} name="description">
    <meta content={SITE.author} name="author">
    <link href="/sitemap-index.xml" rel="sitemap">

    <!-- Open Graph -->
    <meta content="website" property="og:type">
    <meta content={SITE.title} property="og:site_name">
    <meta content={title} property="og:title">
    <meta content={description} property="og:description">
    <meta content={canonicalURL} property="og:url">
    <meta content={socialImageURL} property="og:image">

    <!-- Twitter / X -->
    <meta content="summary_large_image" property="twitter:card">
    <meta content={canonicalURL} property="twitter:url">
    <meta content={title} property="twitter:title">
    <meta content={description} property="twitter:description">
    <meta content={socialImageURL} property="twitter:image">

    <!-- Filled at runtime by theme.ts to match the current background -->
    <meta content="" name="theme-color">

    <!-- Extra head content injected by pages (JSON-LD, etc.) -->
    <slot name="head" />

    <!--
      Inline FOUC-prevention script: sets data-theme on <html> before the
      browser paints. The page is fully readable before (and without) any
      hydration — the theme toggle is an enhancement.

      Light is the default surface. The OS dark preference is deliberately
      NOT consulted: dark ships only when the reader picks it from the toggle.
    -->
    <script is:inline>
      (() => {
        const stored = localStorage.getItem("theme"),
         theme = stored ?? "light",
         root = document.firstElementChild;
        if (root) {
          root.dataset.theme = theme;
        }
        root?.classList.toggle("dark", theme === "dark");
        // Expose value so theme.ts can skip re-detection.
        window.__theme = { value: theme };
      })();
    </script>

    <ClientRouter />
  </head>
  <body
    class="bg-surface font-ui text-ink flex min-h-svh flex-col text-[0.90625rem] leading-normal"
  >
    <a
      class="ald-meta bg-ink text-surface sr-only z-50 px-3 py-2 focus:not-sr-only focus:absolute focus:top-2 focus:left-2"
      href="#main"
      >Skip to content</a
    >
    <slot />
    <script>
      import "@/scripts/theme";
    </script>
  </body>
</html>
