{
  "name": "digest-law",
  "version": "6.1.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=24576 astro dev",
    "dev:preview": "NODE_OPTIONS=--max-old-space-size=12288 PREVIEW_BUNDLES=10 astro dev",
    "build": "pnpm run frontmatter:check && node scripts/patch-astro-store-writer.mjs --check && rm -rf public/pagefind && ASTRO_PRERENDER_WORKERS=${ASTRO_PRERENDER_WORKERS:-4} NODE_OPTIONS=--max-old-space-size=24576 astro build && pagefind --site dist && cp -r dist/pagefind public/",
    "build:preview": "rm -rf dist-preview && NODE_OPTIONS=--max-old-space-size=12288 PREVIEW_BUNDLES=10 astro build && pagefind --site dist-preview",
    "preview:preview": "NODE_OPTIONS=--max-old-space-size=12288 PREVIEW_BUNDLES=10 astro preview",
    "preview": "NODE_OPTIONS=--max-old-space-size=24576 astro preview",
    "sync": "NODE_OPTIONS=--max-old-space-size=24576 astro sync",
    "astro": "astro",
    "format:check": "oxfmt --check .",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "check": "ultracite check",
    "deploy": "pnpm run ids:check && bun scripts/deploy-shards.ts",
    "deploy:full": "pnpm run frontmatter:check && pnpm run ids:check && node scripts/patch-astro-store-writer.mjs --check && rm -rf public/pagefind && ASTRO_PRERENDER_WORKERS=${ASTRO_PRERENDER_WORKERS:-4} NODE_OPTIONS=--max-old-space-size=12288 astro build && pagefind --site dist && cp -r dist/pagefind public/ && bun scripts/deploy-shards.ts",
    "deploy:plan": "bun scripts/deploy-shards.ts --plan",
    "fix": "ultracite fix",
    "frontmatter:check": "bun scripts/check-digest-frontmatter.ts",
    "ids:check": "bun scripts/mint-concept-ids.ts --check",
    "ids:mint": "bun scripts/mint-concept-ids.ts",
    "ids:check:main": "bun scripts/mint-concept-ids.ts --check --from-git ../key-digest-runner origin/main",
    "ids:mint:main": "git -C ../key-digest-runner fetch -q origin && bun scripts/mint-concept-ids.ts --from-git ../key-digest-runner origin/main",
    "skos:check": "bun scripts/check-skos.ts",
    "test": "bun test src worker",
    "postinstall": "node scripts/patch-astro-store-writer.mjs",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.1",
    "dayjs": "^1.11.23",
    "gray-matter": "^4.0.3",
    "lodash.kebabcase": "^4.1.1",
    "rehype-callouts": "^2.2.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@bruits/satteri-wasm32-wasi": "^0.11.0",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@pagefind/default-ui": "^1.5.2",
    "@shikijs/transformers": "^4.5.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/bun": "^1.4.3",
    "@types/lodash.kebabcase": "^4.1.9",
    "lefthook": "^2.2.2",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "pagefind": "^1.5.2",
    "tinyglobby": "^0.2.17",
    "typescript": "^7.0.2",
    "ultracite": "8.0.1",
    "wrangler": "^4.151.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx,astro}": [
      "ultracite fix"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
