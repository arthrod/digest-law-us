{
  "name": "digest-law",
  "version": "6.1.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--max-old-space-size=24576 astro dev",
    "dev:preview": "NODE_OPTIONS=--max-old-space-size=12288 PREVIEW_BUNDLES=10 astro dev",
    "build": "rm -rf public/pagefind && NODE_OPTIONS=--max-old-space-size=24576 astro build && pagefind --site dist && cp -r dist/pagefind public/",
    "build:preview": "rm -rf dist-preview && NODE_OPTIONS=--max-old-space-size=12288 PREVIEW_BUNDLES=10 astro build && pagefind --site dist-preview",
    "preview:preview": "NODE_OPTIONS=--max-old-space-size=12288 PREVIEW_BUNDLES=10 astro preview",
    "preview": "NODE_OPTIONS=--max-old-space-size=24576 astro preview",
    "sync": "NODE_OPTIONS=--max-old-space-size=24576 astro sync",
    "astro": "astro",
    "format:check": "oxfmt --check .",
    "format": "oxfmt .",
    "lint": "oxlint .",
    "check": "ultracite check",
    "deploy": "rm -rf public/pagefind && NODE_OPTIONS=--max-old-space-size=12288 astro build && pagefind --site dist && cp -r dist/pagefind public/ && bun scripts/deploy-shards.ts",
    "deploy:plan": "bun scripts/deploy-shards.ts --plan",
    "fix": "ultracite fix",
    "ids:check": "bun scripts/mint-concept-ids.ts --check",
    "ids:mint": "bun scripts/mint-concept-ids.ts",
    "skos:check": "bun scripts/check-skos.ts",
    "test": "bun test src worker",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.1",
    "dayjs": "^1.11.21",
    "gray-matter": "^4.0.3",
    "lodash.kebabcase": "^4.1.1",
    "rehype-callouts": "^2.2.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.29.0",
    "sharp": "^0.35.3",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@bruits/satteri-wasm32-wasi": "^0.9.5",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@pagefind/default-ui": "^1.5.2",
    "@shikijs/transformers": "^4.4.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/bun": "^1.3.14",
    "@types/lodash.kebabcase": "^4.1.9",
    "lefthook": "^2.1.10",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "pagefind": "^1.5.2",
    "typescript": "^7.0.2",
    "ultracite": "7.10.3",
    "wrangler": "^4.122.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx,astro}": [
      "ultracite fix"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
