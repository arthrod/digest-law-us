{
  "name": "digest-law",
  "version": "6.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "rm -rf public/pagefind && NODE_OPTIONS=--max-old-space-size=12288 astro build && pagefind --site dist && cp -r dist/pagefind public/",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "check": "ultracite check",
    "deploy": "rm -rf public/pagefind && NODE_OPTIONS=--max-old-space-size=12288 astro build && pagefind --site dist && cp -r dist/pagefind public/ && wrangler deploy",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.6",
    "dayjs": "^1.11.21",
    "gray-matter": "^4.0.3",
    "lodash.kebabcase": "^4.1.1",
    "rehype-callouts": "^2.2.0",
    "remark-collapse": "^0.1.2",
    "remark-toc": "^9.0.0",
    "satori": "^0.29.0",
    "sharp": "^0.35.3",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@bruits/satteri-wasm32-wasi": "^0.9.5",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@pagefind/default-ui": "^1.5.2",
    "@shikijs/transformers": "^4.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/lodash.kebabcase": "^4.1.9",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint-plugin-astro": "^3.0.1",
    "lefthook": "^2.1.10",
    "lint-staged": "^17.2.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "pagefind": "^1.5.2",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^7.0.2",
    "ultracite": "7.2.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "pnpm dlx ultracite fix"
    ]
  }
}
